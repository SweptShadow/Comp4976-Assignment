@page "/obituaries/{id:int}"
@using frontend.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(obituary?.FullName ?? "Obituary Details")</PageTitle>

@if (loading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border me-2" role="status" aria-hidden="true"></div>
        <span>Loading obituary...</span>
    </div>
}
else if (obituary is null)
{
    <div class="alert alert-warning">Obituary not found.</div>
}
else
{
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-12 col-md-4">
                @if (!string.IsNullOrWhiteSpace(obituary.PhotoPath))
                {
                    <img src="@ToAbsolute(obituary.PhotoPath)" alt="@obituary.FullName" class="img-fluid rounded shadow-sm" />
                }
                else
                {
                    <div class="placeholder-tile d-flex align-items-center justify-content-center rounded">
                        <span class="display-4 text-muted">@GetInitial(obituary.FullName)</span>
                    </div>
                }
            </div>
            <div class="col-12 col-md-8">
                <div class="detail-grid">
                    <div class="label">NAME</div>
                    <div class="value h3 mb-3">@obituary.FullName</div>

                    <div class="label">DATE OF BIRTH</div>
                    <div class="value mb-3">@obituary.DateOfBirth.ToString("yyyy-MM-dd")</div>

                    <div class="label">DATE OF DEATH</div>
                    <div class="value mb-3">@obituary.DateOfDeath.ToString("yyyy-MM-dd")</div>

                    @if (!string.IsNullOrWhiteSpace(obituary.Biography))
                    {
                        <div class="label">BIOGRAPHY</div>
                        <div class="value mb-3">@obituary.Biography</div>
                    }

                    <div class="label">CREATED BY</div>
                    <div class="value mb-3">
                        @if (!string.IsNullOrWhiteSpace(obituary.CreatedByEmail))
                        {
                            @obituary.CreatedByEmail
                        }
                        else if (!string.IsNullOrWhiteSpace(obituary.SubmittedByName))
                        {
                            @obituary.SubmittedByName
                        }
                        else
                        {
                            @obituary.CreatedBy
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <AuthorizeView>
                        <Authorized>
                            <a class="btn btn-warning me-2" href="/obituaries/edit/@obituary.Id">Edit</a>
                        </Authorized>
                    </AuthorizeView>
                    <button class="btn btn-outline-secondary" @onclick="GoBack">Back to List</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Obituary? obituary;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            obituary = await Http.GetFromJsonAsync<Obituary>($"api/ObituariesApi/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading obituary: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private static string GetInitial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private void GoBack() => Navigation.NavigateTo("/obituaries");

    private string? ToAbsolute(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        var baseUri = Http.BaseAddress?.ToString()?.TrimEnd('/') ?? string.Empty;
        var rel = path.TrimStart('/');
        return string.IsNullOrEmpty(baseUri) ? "/" + rel : $"{baseUri}/{rel}";
    }
}
