@page "/obituaries/edit/{Id:int}"
@using frontend.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Edit Obituary</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        @if (loading)
        {
            <div class="d-flex align-items-center my-4">
                <div class="spinner-border me-2" role="status" aria-hidden="true"></div>
                <span>Loading obituary...</span>
            </div>
        }
        else if (errorMessage != null && errorMessage.Length > 0)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (editingObituary != null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Edit Obituary</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="editingObituary" OnValidSubmit="SaveAsync" Context="editCtx">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="fullName" class="form-label">Full Name</label>
                            <InputText id="fullName" class="form-control" @bind-Value="editingObituary.FullName" />
                            <ValidationMessage For="() => editingObituary.FullName" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="dateOfBirth" class="form-label">Date of Birth</label>
                                <InputDate id="dateOfBirth" class="form-control"
                                    @bind-Value="editingObituary.DateOfBirth" />
                                <ValidationMessage For="() => editingObituary.DateOfBirth" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="dateOfDeath" class="form-label">Date of Death</label>
                                <InputDate id="dateOfDeath" class="form-control"
                                    @bind-Value="editingObituary.DateOfDeath" />
                                <ValidationMessage For="() => editingObituary.DateOfDeath" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="biography" class="form-label">Biography <span class="text-danger">*</span></label>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">Provide a detailed description of the person's life and
                                    legacy.</small>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="EnhanceWithAi"
                                    disabled="@(isSubmitting || isEnhancing || string.IsNullOrWhiteSpace(editingObituary.FullName))">
                                    @if (isEnhancing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Enhancing...</span>
                                    }
                                    else
                                    {
                                        <span>@GetAiButtonText()</span>
                                    }
                                </button>
                            </div>
                            <InputTextArea id="biography" class="form-control" rows="6"
                                @bind-Value="editingObituary.Biography" />
                            <ValidationMessage For="() => editingObituary.Biography" />
                            @if (!string.IsNullOrEmpty(aiErrorMessage))
                            {
                                <div class="text-danger mt-2">
                                    <small>@aiErrorMessage</small>
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Photo</label>
                            <InputFile OnChange="OnFileSelected" accept="image/*" />
                            <small class="form-text text-muted d-block">Leave empty to keep existing photo.</small>
                            @if (!string.IsNullOrWhiteSpace(editingObituary.PhotoPath))
                            {
                                <div class="mt-2">
                                    <img src="@editingObituary.PhotoPath" alt="Photo preview" class="img-thumbnail"
                                        style="max-width: 240px;" />
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">@(isSubmitting ?
                                                            "Saving..." : "Save")</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack"
                                disabled="@isSubmitting">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">Please sign in to edit an obituary.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }

    private Obituary? editingObituary;
    private string errorMessage = string.Empty;
    private string aiErrorMessage = string.Empty;
    private bool isSubmitting;
    private bool isEnhancing;
    private bool loading = true;

    private string GetAiButtonText()
    {
        return string.IsNullOrWhiteSpace(editingObituary?.Biography)
        ? "Generate Description with AI"
        : "Enhance Description with AI";
    }

    private async Task EnhanceWithAi()
    {
        if (editingObituary == null || string.IsNullOrWhiteSpace(editingObituary.FullName))
        {
            aiErrorMessage = "Please enter the full name first";
            return;
        }

        aiErrorMessage = string.Empty;
        isEnhancing = true;

        try
        {
            var request = new
            {
                FullName = editingObituary.FullName,
                CurrentDescription = string.IsNullOrWhiteSpace(editingObituary.Biography) ? null : editingObituary.Biography
            };

            var response = await Http.PostAsJsonAsync("api/ObituariesApi/enhance-description", request);

            if (response.IsSuccessStatusCode)
            {
                var responseText = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(responseText))
                {
                    // Parse JSON response: { "enhancedDescription": "..." }
                    try
                    {
                        var jsonDoc = System.Text.Json.JsonDocument.Parse(responseText);
                        if (jsonDoc.RootElement.TryGetProperty("enhancedDescription", out var descElement))
                        {
                            editingObituary.Biography = descElement.GetString() ?? string.Empty;
                        }
                        else
                        {
                            aiErrorMessage = "AI service returned invalid response format.";
                        }
                    }
                    catch (System.Text.Json.JsonException)
                    {
                        aiErrorMessage = "AI service returned invalid JSON response.";
                    }
                }
                else
                {
                    aiErrorMessage = "AI service returned empty response. Please try again.";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.RequestTimeout)
            {
                aiErrorMessage = "Request timed out. Please try again.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
            {
                aiErrorMessage = "AI service is temporarily unavailable. Please try again later.";
            }
            else
            {
                aiErrorMessage = "An error occurred while enhancing the description. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            aiErrorMessage = "Network error. Please check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            aiErrorMessage = "Request timed out. Please try again.";
        }
        catch (Exception)
        {
            aiErrorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isEnhancing = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            editingObituary = await Http.GetFromJsonAsync<Obituary>($"api/ObituariesApi/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = string.Empty;
        if (editingObituary is null)
        {
            errorMessage = "Obituary not loaded.";
            return;
        }

        if (editingObituary.DateOfDeath < editingObituary.DateOfBirth)
        {
            errorMessage = "Date of death cannot be before date of birth.";
            return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/ObituariesApi/{editingObituary.Id}", editingObituary);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/obituaries", forceLoad: true);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized || response.StatusCode ==
            System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "You must be signed in and authorized to edit this obituary.";
            }
            else
            {
                errorMessage = $"Error saving obituary: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/obituaries");

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file is null) return;
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(20 * 1024 * 1024); // 20MB
            var sc = new StreamContent(stream);
            sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(sc, "file", file.Name);
            var resp = await Http.PostAsync("api/Upload/photo", content);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<frontend.Models.UploadResult>();
                if (result != null && !string.IsNullOrWhiteSpace(result.Url))
                {
                    editingObituary!.PhotoPath = result.Url;
                }
            }
            else
            {
                errorMessage = $"Upload failed: {resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}