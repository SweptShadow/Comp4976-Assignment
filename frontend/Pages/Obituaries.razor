@page "/obituaries"
@using frontend.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Obituaries</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 page-header-sticky">
    <div>
        <h1 class="mb-0">Obituaries</h1>
        <p class="text-muted mb-0">Browse, search, and remember.</p>
    </div>
    <AuthorizeView>
        <Authorized>
            <a class="btn btn-dark" href="/obituaries/new">+ Create New</a>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-outline-primary" href="/login">Sign in to create</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="row g-2 align-items-center mb-3">
    <div class="col-12">
        <div class="d-flex">
            <input type="text" class="form-control flex-grow-1 me-2" placeholder="Search by name" @bind="searchTerm" @bind:event="oninput" />
            <button class="btn btn-dark me-2" @onclick="SearchObituraries">Search</button>
            <button class="btn btn-outline-secondary" @onclick="ClearSearch">Clear</button>
        </div>
    </div>
</div>

@if (obituaries == null)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border me-2" role="status" aria-hidden="true"></div>
        <span>Loading obituaries...</span>
    </div>
}
else if (obituaries.Count == 0)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>No obituaries found.</span>
        <AuthorizeView>
            <Authorized>
                <a class="btn btn-sm btn-primary" href="/obituaries/new">Create one</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-outline-primary" href="/login">Sign in to create</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="row">
        @foreach (var obituary in obituaries)
        {
            <div class="col-12 col-md-6 col-xl-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrWhiteSpace(obituary.PhotoPath))
                    {
                        <img src="@ToAbsolute(obituary.PhotoPath)" class="card-img-top" alt="@obituary.FullName" />
                    }
                    else
                    {
                        <div class="placeholder-tile d-flex align-items-center justify-content-center rounded-top">
                            <span class="display-4 text-muted">@GetInitial(obituary.FullName)</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@obituary.FullName</h5>
                        <p class="card-text">
                            <small>@obituary.DateOfBirth.ToString("yyyy-MM-dd") - @obituary.DateOfDeath.ToString("yyyy-MM-dd")</small>
                        </p>
                        <p class="card-text card-bio" title="@obituary.Biography">
                            @if (!string.IsNullOrWhiteSpace(obituary.Biography))
                            {
                                @(obituary.Biography.Length > 100 ? obituary.Biography.Substring(0, 100) + "..." : obituary.Biography)
                            }
                        </p>
                        <div class="actions">
                            <a href="/obituaries/@obituary.Id" class="btn btn-outline-primary btn-sm me-2">Details</a>
                            <AuthorizeView>
                                <Authorized>
                                    <a class="btn btn-outline-warning btn-sm me-2" href="/obituaries/edit/@obituary.Id">Edit</a>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteObituary(obituary.Id)">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <span>Page @currentPage of @totalPages (Total: @totalCount obituaries)</span>
        <div>
            @if (currentPage > 1)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousPage">Previous</button>
            }
            @if (currentPage < totalPages)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage">Next</button>
            }
        </div>
    </div>
}

@code {
    private List<Obituary>? obituaries;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private int totalCount = 0;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadObituraries();
    }

    private async Task LoadObituraries()
    {
        try
        {
            var query = $"api/ObituariesApi?page={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query += $"&search={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await Http.GetFromJsonAsync<ObituaryListResponse>(query);
            obituaries = response?.Items ?? new List<Obituary>();
            totalCount = response?.Total ?? 0;
            totalPages = totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading obituaries: {ex.Message}");
            obituaries = new List<Obituary>();
        }
    }

    private async Task SearchObituraries()
    {
        currentPage = 1;
        await LoadObituraries();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadObituraries();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadObituraries();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadObituraries();
        }
    }

    private async Task DeleteObituary(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this obituary?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/ObituariesApi/{id}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadObituraries();
                }
                else
                {
                    if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized || response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "You must be signed in to delete.");
                    }
                    else
                    {
                        Console.WriteLine($"Error deleting obituary: {response.StatusCode}");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting obituary: {ex.Message}");
            }
        }
    }

    public class ObituaryListResponse
    {
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int Total { get; set; }
        public List<Obituary> Items { get; set; } = new();
    }

    private static string GetInitial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private string? ToAbsolute(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return null;
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        var baseUri = Http.BaseAddress?.ToString()?.TrimEnd('/') ?? string.Empty;
        var rel = path.TrimStart('/');
        return string.IsNullOrEmpty(baseUri) ? "/" + rel : $"{baseUri}/{rel}";
    }
}
